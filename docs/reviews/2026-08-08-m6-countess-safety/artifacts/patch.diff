+class CapturingLog:
+    enabled = True
+
+    def __init__(self) -> None:
+        self.events = []
+
+    # `kind` positional-only, like the real RunLog: the envelope owns
+    # that key and a field of the same name would overwrite it.
+    def event(self, kind, /, **fields):
+        self.events.append((kind, fields))
