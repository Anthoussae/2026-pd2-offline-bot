+
+def test_walking_near_still_does_nothing_at_a_sane_distance(town):
+    """The other end stays intact: already in range means no walk at all —
+    the shortest walk is none."""
+    target = (5884, 5709)
+    town.pos = (target[0] + 8, target[1])
