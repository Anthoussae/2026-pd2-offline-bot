+  "shael_rune", "dol_rune", "hel_rune", "io_rune", "lum_rune", "ko_rune",
+  "fal_rune", "lem_rune", "pul_rune", "um_rune", "mal_rune", "ist_rune",
+  "gul_rune", "vex_rune", "ohm_rune", "lo_rune", "sur_rune", "ber_rune",
+  "jah_rune", "cham_rune", "zod_rune",
+]
+charms = ["small_charm", "large_charm", "grand_charm"]
+jewelry = ["jewel", "ring", "amulet"]
+necro_heads = [
+  "minion_skull", "overseer_skull", "succubus_skull", "hellspawn_skull",
+  "bloodlord_skull",
+]
+quest_and_map_items = [
+  "worldstone_shard", "larzuks_puzzlebox", "larzuks_puzzlepiece", "tainted_worldstone_shard", "skeleton_key", "vial_of_lightsong",
+  "liliths_mirror", "relic_of_the_ancients", "sigil_of_madawc",
+  "sigil_of_talic", "sigil_of_korlic", "prime_evil_soul", "black_soulstone",
+  "pure_demonic_essence", "splinter_of_the_void",
+  "trang_ouls_jawbone", "hellfire_ashes", "flesh_of_malic",
+  "key_of_terror", "key_of_hate", "key_of_destruction",
