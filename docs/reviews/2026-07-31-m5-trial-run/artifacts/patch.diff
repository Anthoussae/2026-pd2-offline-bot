index 0000000..01197dc
--- /dev/null
+++ b/config/item_ids.learned.toml
@@ -0,0 +1,115 @@
+# Item ids learned after item_ids.toml was written; merged over its
+# [pending] list at load time. Machine-generated - do not hand-edit.
+#
+# Codes read live from the game's item table (T42). Each name binds to
+# BOTH the classic record and PD2's `s`-suffixed one, because PD2
+# carries both and it is the `s` family that drops - established when
+# T39's first two items came back as r15s (Hel rune, kind 713) and
+# gpbs (Perfect Sapphire, kind 690) against a first pass that had
+# bound those names to the classic 639 and 586 (R126). Binding both is
+# safe: an item is one record or the other, never both.
+
+[verified]
+amulet = 535 # amu
+ring = 537 # rin
+flawless_amethyst = [575, 685] # gzv + gzvs
+perfect_amethyst = [576, 686] # gpv + gpvs
+flawless_topaz = [580, 687] # gly + glys
+perfect_topaz = [581, 688] # gpy + gpys
+flawless_sapphire = [585, 689] # glb + glbs
+perfect_sapphire = [586, 690] # gpb + gpbs
+flawless_emerald = [590, 691] # glg + glgs
+perfect_emerald = [591, 692] # gpg + gpgs
+flawless_ruby = [595, 693] # glr + glrs
+perfect_ruby = [596, 694] # gpr + gprs
+flawless_diamond = [600, 695] # glw + glws
+perfect_diamond = [601, 696] # gpw + gpws
+flawless_skull = [615, 697] # skl + skls
+perfect_skull = [616, 698] # skz + skzs
+small_charm = 618 # cm1
+large_charm = 619 # cm2
+grand_charm = 620 # cm3
+el_rune = [625, 699] # r01 + r01s
+eld_rune = [626, 700] # r02 + r02s
