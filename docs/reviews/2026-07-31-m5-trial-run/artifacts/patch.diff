diff --git a/config/necro.toml b/config/necro.toml
new file mode 100644
index 0000000..92f00fe
--- /dev/null
+++ b/config/necro.toml
@@ -0,0 +1,157 @@
+# The poison dagger necromancer — everything class-specific in one file.
+#
+# This file is meant to be READ AND TUNED BY A HUMAN (R46 Q3). Every number
+# here was user-approved at R49 (with the R53 belt layout and the 15 s mana
+# cooldown amendment); change them here, never in code. The loader refuses
+# unknown keys loudly, so a typo fails at startup instead of silently
+# defaulting mid-run.
+
+name = "necromancer"
+
+# Skill ids as captured LIVE from this character (P1 drill A, R52). These
+# are PD2's ids, which differ from classic D2 in places (blood warp 367,
+# desecrate 83 in a classic slot).
+[skills]
+poison_strike = 73 # the permanent left skill; offense never switches (R47)
+bone_armor = 68
+blood_warp = 367
+tp_tome = 220      # bound but unused in M5
+bone_wall = 78     # bound but unused in M5
+desecrate = 83
+revive = 95
+
+# Right-skill hotkeys as bound in the client (R47.1). If the in-game
+# bindings change, change these to match — the bot presses these keys and
+# then VERIFIES the switch from memory before any cast (skills.py).
+[hotkeys]
+bone_armor = "F1"
+blood_warp = "F2"
+tp_tome = "F3"
+bone_wall = "F4"
+desecrate = "F5"
+revive = "F6"
+
+# The PERMANENT belt layout (user declaration, R53 — supersedes R47.6):
+# key 1 mana, key 2 rejuv, keys 3+4 healing. Columns are listed left to
+# right; the drink keys are the column number plus one. The minimums are
+# the town layer's loud-halt floor after a refill (R48: no vendor UI —
+# below minimum means halt for a manual restock).
+[belt]
+columns = ["mana", "rejuv", "healing", "healing"]
+min_healing = 4
+min_mana = 2
+min_rejuv = 0 # rejuvs cannot be bought; advisory only (R47.6)
+
+# The survival reflex ladder (R49). Rungs, top priority first:
+#   1 death latch, 2 chicken     -> SafetyMonitor's, not the ladder's
+#   3 rejuv, 4 blood warp, 5 heal potion, 6 mana potion,
+#   7 disengage, 8 upkeep        -> the ladder's, numbers below
+# The ladder only runs OUT of town (town guards read as monsters to
+# perception, and drink rules are out-of-town only) — except the armor
+# recast, see armor_in_town.
+[reflex]
+# Rung 2 — the chicken threshold. Listed here because the user tunes it
+# with the rest, but it is enforced by SafetyMonitor, not the ladder.
+chicken_life_pct = 35.0
+
+# Rung 3 — rejuv: below this hp%, drink the rejuv column (no cooldown).
+# With the column EMPTY and this many hostiles this close, escalate
+# straight to blood warp.
+rejuv_below_pct = 50.0
+escalate_hostiles = 2
+escalate_radius = 10
+
+# Rung 4 — blood warp, escape only, never traversal (R47.3). Trigger:
+# packed in (warp_hostiles within warp_radius AND hp below warp_hp_pct),
+# or burst down (more than warp_loss_pct of max hp lost within
+# warp_loss_window_s). Guards: the cast costs 10 mana and
+# max(warp_cost_pct of max hp, warp_cost_floor) hp — never cast without
+# warp_min_mana mana or with hp at or below twice the hp cost.
+warp_hostiles = 4
+warp_radius = 8
+warp_hp_pct = 60.0
+warp_loss_pct = 25.0
+warp_loss_window_s = 2.0
+warp_min_mana = 10
+warp_cost_pct = 12.0
+warp_cost_floor = 12
+# The warp's own cooldown is unknown-length, so it is verified by effect:
+# an attempt that moved the player warp_verify_move subtiles landed; until
+# then, re-casts are blocked for warp_retry_s.
+warp_verify_move = 10
+warp_retry_s = 2.0
+# Where to flee: a walkable spot this far from the hostile centroid.
+retreat_distance = 20
+# Which skills the two casting rungs use (names from [skills] above).
+escape_skill = "blood_warp"
+armor_skill = "bone_armor"
+
+# Rung 5 — healing potion: below this hp%, drink a healing column, at
+# most once per heal_cooldown_s. The second healing column is the backup.
+heal_below_pct = 100.0
+heal_cooldown_s = 10.0
+
+# Rung 6 — mana potion: below this mana%, at most once per
+# mana_cooldown_s (15 s — the R49 amendment; was proposed at 5).
+mana_below_pct = 25.0
+mana_cooldown_s = 15.0
+
+# Rung 7 — disengage: bone armor down AND still on recast cooldown AND hp
+# below this: retreat from the pack instead of trading hits unarmored.
+disengage_hp_pct = 70.0
+
+# Rung 8 — upkeep: recast bone armor when its remaining absorb falls
+# below armor_recast_below_pct (fallback when the stat is unreadable:
+# recast after being hit, R47.2). armor_retry_s paces attempts, since the
+# real cooldown cannot be read. armor_in_town lets the recast happen in
+# town too (castable there, proven live in P2; arriving armored is
+# strictly better). Desecrate/revive upkeep is the combat module's and
+# never runs in town (R47.4).
+armor_recast_below_pct = 75.0
+armor_retry_s = 2.0
+armor_in_town = true
+
+# The skirmish pattern, in the user's own words (R47.2): "on contact, wait
+# briefly for revives to engage -> dash in -> left-click the monster ->
+# run back out of danger -> recast bone armor if low -> repeat until the
+# pack is dead." The numbers below are the parts that description leaves
+# open; they are judgment calls, tune them freely.
+#
+# Offense itself has no knobs: the left skill is permanently Poison
+# Strike, so an attack is a left-click on the monster (R47.1).
+[combat]
+# Hostiles within engage_radius mean "we are in a fight". melee_range is
+# close enough to strike. The dash happens in hops of at most dash_step
+# subtiles rather than one long walk — a blocking walk into a pack is
+# time the survival ladder is NOT being consulted, and the ladder is what
+# keeps this character alive.
+engage_radius = 40
+melee_range = 3
+dash_step = 8
+# How far back out of the pack after each strike.
+retreat_subtiles = 12
+# Poison does the killing, so a struck monster is already dying: prefer
+# fresh targets and only re-hit a survivor after this long.
+restrike_s = 6.0
+
+# Revives as aggro tanks. On contact, hold up to wait_for_revives_s for
+# them to get in front — the wait ends early once one of them is within
+# revive_engaged_range of a hostile, since it is waiting for them to
+# TANK, not waiting out a timer.
+wait_for_revives_s = 1.5
+revive_engaged_range = 8
+# Keep this many revives up (R47.4). They last ~300 s; the count is
+# re-checked every tick, so expiry heals itself.
+revive_target = 3
+# Corpses this close count as revive fuel.
+revive_search_radius = 15
+# Desecrate makes corpses. Bounded: if it produces none (nothing died
+# nearby, skill on cooldown), stop after this many rounds rather than
+# recasting forever — every one of those ticks is a tick not fighting.
+# The settle delays stop the bot re-casting before the last cast resolved.
+desecrate_rounds = 2
+desecrate_settle_s = 1.0
+revive_settle_s = 0.6
+# Which skills the maintenance uses (names from [skills] above).
+desecrate_skill = "desecrate"
+revive_skill = "revive"
diff --git a/config/pickit.toml b/config/pickit.toml
new file mode 100644
index 0000000..6133a83
--- /dev/null
+++ b/config/pickit.toml
@@ -0,0 +1,146 @@
+# What to pick up off the ground — the R117 list. Edit freely; this file
+# is meant to be read and changed by a human, and nothing in the code
+# needs to change with it.
+#
+# HOW IT WORKS: rules are checked TOP DOWN and THE FIRST MATCH WINS. An
+# item that matches no rule is left on the ground. Order matters: a broad
+# rule above a narrow one silences the narrow one completely.
+#
+# Conditions a rule may state (omitted ones do not constrain):
+#
+#   kinds           item names or group names from config/item_ids.toml,
+#                   plus the potion groups (healing_potion, mana_potion,
+#                   rejuv_potion, any_potion)
+#   qualities       low, normal, superior, magic, set, rare, unique, crafted
+#   sockets         e.g. [3, 4] — WAITS on the T38 drill verifying the
+#                   socket read; until then these rules match nothing
+#   potion_reserve  match while the belt has room for this potion type OR
+#                   fewer than N of it sit in the inventory (R118 Q1)
+#
+# Actions: keep (bring home), belt (potion), pick (gold), skip (leave —
+# useful to carve an exception out of a later, broader rule).
+#
+# MANY NAMES ARE STILL PENDING their id (see item_ids.toml): PD2
+# renumbered item kinds, so every id must be read from the live game
+# (T39 placement drill). A rule naming a pending item loads fine and
+# matches nothing until the drill fills the id in.
+
+# -- potions (R118 Q1: belt first, then a reserve of 2 per type) ---------------
+
+[[rule]]
+name = "healing potions to belt and reserve"
+kinds = ["healing_potion"]
+potion_reserve = 2
+action = "belt"
+
+[[rule]]
+name = "mana potions to belt and reserve"
+kinds = ["mana_potion"]
+potion_reserve = 2
+action = "belt"
+
+[[rule]]
+name = "rejuvs to belt and reserve"
+kinds = ["rejuv_potion"]
+potion_reserve = 2
+action = "belt"
+
+# -- gems and runes ------------------------------------------------------------
+
+[[rule]]
+name = "flawless and perfect gems and skulls"
+kinds = ["gems_flawless_perfect"]
+action = "keep"
+
+[[rule]]
+name = "all runes"
+kinds = ["runes"]
+action = "keep"
+
+# -- charms and jewelry --------------------------------------------------------
+
+[[rule]]
+name = "unique charms"
+kinds = ["charms"]
+qualities = ["unique"]
+action = "keep"
+
+[[rule]]
+name = "rare and unique jewels, rings, amulets"
+kinds = ["jewelry"]
+qualities = ["rare", "unique"]
+action = "keep"
+
+# -- unique bases --------------------------------------------------------------
+
+[[rule]]
+name = "unique necro heads"
+kinds = ["necro_heads"]
+qualities = ["unique"]
+action = "keep"
+
+[[rule]]
+name = "unique shako"
+kinds = ["shako"]
+qualities = ["unique"]
+action = "keep"
+
+[[rule]]
+name = "unique belts (spiderweb sash, mithril coil)"
+kinds = ["spiderweb_sash", "mithril_coil"]
+qualities = ["unique"]
+action = "keep"
+
+[[rule]]
+name = "unique knives (cinquedeas, bone knife)"
+kinds = ["cinquedeas", "bone_knife"]
+qualities = ["unique"]
+action = "keep"
+
+[[rule]]
+name = "unique body armor bases"
+kinds = [
+  "dusk_shroud", "wire_fleece", "balrog_skin", "kraken_shell",
+  "shadow_plate", "sacred_armor",
+]
+qualities = ["unique"]
+action = "keep"
+
+# -- socketed bases (held back until T38 verifies the socket read) -------------
+
+[[rule]]
+name = "3-socket necro heads"
+kinds = ["necro_heads"]
+sockets = [3]
+action = "keep"
+
+[[rule]]
+name = "3- and 4-socket archon plate"
+kinds = ["archon_plate"]
+sockets = [3, 4]
+action = "keep"
+
+# -- set bases -----------------------------------------------------------------
+
+[[rule]]
+name = "set bases"
+kinds = [
+  "bone_visage", "chaos_armor", "cantor_trophy", "troll_belt",
+  "heavy_bracers",
+]
+qualities = ["set"]
+action = "keep"
+
+# -- quest, map and event items ------------------------------------------------
+
